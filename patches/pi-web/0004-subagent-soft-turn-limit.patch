+test("soft turn limit steers once and never aborts later tool turns", async () => {
+  const source = await readFile(new URL("./subagent-runtime.ts", import.meta.url), "utf8");
+  const listener = source.match(/inner\.subscribe\(\(event\) => \{([\s\S]*?)\n          \}\)/)[1];
+  const steered = [];
+  let aborted = 0;
+  const run = new Function("inner", "turnLimit", `let turnCount = 0; let softLimitReached = false; return (event) => {${listener}};`);
+  const onEvent = run({ steer: message => steered.push(message), abort: () => aborted++ }, 2);
+  onEvent({ type: "message_end" });
+  onEvent({ type: "turn_end" });
+  assert.equal(steered.length, 0);
+  for (let i = 0; i < 10; i++) onEvent({ type: "turn_end", message: { stopReason: "toolUse" } });
+  assert.equal(steered.length, 1);
+  assert.equal(aborted, 0);
+});
