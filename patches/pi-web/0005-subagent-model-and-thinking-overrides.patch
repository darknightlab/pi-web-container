+interface SubagentModelSwitch {
+  model?: NonNullable<ReturnType<typeof findSubagentModel>>;
+  thinkingLevel?: ThinkingLevel;
+}
+
+/**
+ * The model and thinking level a resume or steer switches a running subagent to. `model` takes
+ * pi's `provider/modelId[:level]` form like a new run's; an explicit `thinking` beats the suffix.
+ * Resolved before anything is queued or sent, so an unknown model or level fails the call itself.
+ */
+function resolveSubagentSwitch(
+  session: AgentSessionLike,
+  model: string | undefined,
+  thinking: string | undefined,
+): SubagentModelSwitch {
+  const runtime = (session as unknown as { modelRuntime: ModelRuntime }).modelRuntime;
+  const parsed = parseSubagentModel(runtime, model);
+  const requestedThinking = thinking?.trim();
+  if (requestedThinking && !THINKING_LEVELS.has(requestedThinking as ThinkingLevel)) {
+    throw new Error(`Invalid subagent thinking level: ${requestedThinking}`);
+  }
+  const thinkingLevel = (requestedThinking as ThinkingLevel | undefined) || parsed?.thinkingLevel;
+  return {
+    ...(parsed ? { model: parsed.model } : {}),
+    ...(thinkingLevel ? { thinkingLevel } : {}),
+  };
+}
+
+async function applySubagentSwitch(session: AgentSessionLike, change: SubagentModelSwitch): Promise<void> {
+  // Model first: setModel re-derives the thinking level, so an explicit level must follow it.
+  if (change.model) await session.setModel(change.model as unknown as Parameters<AgentSessionLike["setModel"]>[0]);
+  if (change.thinkingLevel) session.setThinkingLevel(change.thinkingLevel);
+}
