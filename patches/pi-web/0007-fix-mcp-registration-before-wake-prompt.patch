+test("a custom-message wake after MCP release keeps the server section across turns", async (t) => {
+  await writeMcpConfig({ fixture: { ...fixtureServer(), exposure: "codemode", description: "Fixture server" } });
+  t.after(() => rm(join(agentDir, "mcp.json"), { force: true }));
+  const { session, wrapper, faux, mcpHost } = await startSession(t, { idleMs: 0 });
+  await promptAndSeeTools(wrapper, faux);
+  const currentSection = () => {
+    let section;
+    for (const message of session.messages) {
+      if (message.role === "system" && Object.hasOwn(message.sections ?? {}, "mcp_servers")) {
+        section = message.sections.mcp_servers;
+      }
+    }
+    return section;
+  };
+  const expected = currentSection();
+  assert.match(expected, /mcp__fixture/);
+  await mcpHost.release();
+  assert.deepEqual(mcpHost.serverStates(), []);
+  const before = session.messages.length;
+  const observed = [];
+  faux.setResponses([
+    () => {
+      observed.push(currentSection());
+      return fauxAssistantMessage([fauxToolCall("ls", { path: "." })], { stopReason: "toolUse" });
+    },
+    () => {
+      observed.push(currentSection());
+      return fauxAssistantMessage([fauxText("done")]);
+    },
+  ]);
+  await session.sendCustomMessage({ customType: "pi-web:subagent-notification", content: "Child completed", display: true },
+    { deliverAs: "followUp", triggerTurn: true });
+  assert.deepEqual(observed, [expected, expected], "both wake requests must retain the registered server section");
+  assert.ok(!session.messages.slice(before).some((message) => message.role === "system"
+    && Object.hasOwn(message.sections ?? {}, "mcp_servers")), "an unchanged section must not generate any patch");
+  assert.ok(mcpHost.serverStates().some((server) => server.name === "fixture"));
+});
+
