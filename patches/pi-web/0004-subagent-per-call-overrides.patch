+test("Agent forwards per-call profile overrides to a new subagent and ignores them on resume", async () => {
+  let started;
+  let resumed;
+  const finished = run({ sessionId: "child-session", status: "completed", result: "ok" });
+  const { tools } = await loadTools({
+    async start(request) { started = request; return { run: finished, completion: Promise.resolve(finished) }; },
+    async resume(request) { resumed = request; return { run: finished, completion: Promise.resolve(finished) }; },
+    async get() { return null; },
+    async steer() {},
+  });
+  const context = { sessionManager: { getSessionId: () => "parent-session" } };
+  const overrides = { thinking: "high", max_turns: 6, inherit_context: true };
+  await tools.get("Agent").execute("tool-call", { prompt: "Task", description: "Task", ...overrides }, undefined, undefined, context);
+  assert.equal(started.thinking, "high");
+  assert.equal(started.maxTurns, 6);
+  assert.equal(started.inheritContext, true);
+
+  // Unset values leave the profile in charge.
+  await tools.get("Agent").execute("tool-call", { prompt: "Task", description: "Task", thinking: "", inherit_context: undefined }, undefined, undefined, context);
+  assert.equal(started.thinking, undefined);
+  assert.equal(started.maxTurns, undefined);
+  assert.equal(started.inheritContext, undefined);
+
+  await tools.get("Agent").execute("tool-call", { resume: "child-session", prompt: "More", description: "More", max_turns: 6, inherit_context: true }, undefined, undefined, context);
+  assert.equal(resumed.maxTurns, undefined);
+  assert.equal(resumed.inheritContext, undefined);
+});
+
