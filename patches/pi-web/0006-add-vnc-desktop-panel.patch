@@ -0,0 +1,25 @@
+import { NextResponse } from "next/server";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+
+// The container that owns the virtual desktop configures the embedded noVNC
+// endpoint through the environment. When PI_WEB_VNC_URL is unset the panel
+// reports that the desktop is unavailable instead of embedding a dead iframe.
+function readVncUrl(): string | null {
+  const url = process.env.PI_WEB_VNC_URL?.trim();
+  return url ? url : null;
+}
+
+export function GET() {
+  const url = readVncUrl();
+  const password = process.env.PI_WEB_VNC_PASSWORD;
+  return NextResponse.json({
+    enabled: url !== null,
+    url,
+    // noVNC accepts the password as a URL parameter. It is only echoed when the
+    // operator explicitly exports it, so passwordless desktops stay clean and
+    // the value never appears in the page URL on its own.
+    ...(url && password ? { password } : {}),
+  });
+}
