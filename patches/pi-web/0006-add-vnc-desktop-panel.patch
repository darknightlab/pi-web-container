diff --git a/components/VncPanel.tsx b/components/VncPanel.tsx
new file mode 100644
index 0000000..e04fb2e
--- /dev/null
+++ b/components/VncPanel.tsx
@@ -0,0 +1,92 @@
+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import { useI18n } from "@/hooks/useI18n";
+import type { VncTab } from "./vnc-tab-state";
+
+interface Props {
+  tab: VncTab;
+  active: boolean;
+}
+
+interface VncConfig {
+  enabled: boolean;
+  url: string | null;
+  password?: string;
+}
+
+function withPassword(url: string, password: string | undefined): string {
+  if (!password) return url;
+  const separator = url.includes("?") ? "&" : "?";
+  return `${url}${separator}password=${encodeURIComponent(password)}`;
+}
+
+export function VncPanel({ tab, active }: Props) {
+  const { t } = useI18n();
+  const [config, setConfig] = useState<VncConfig | null | undefined>(undefined);
+  const [reloadKey, setReloadKey] = useState(0);
+
+  useEffect(() => {
+    let cancelled = false;
+    fetch("/api/vnc")
+      .then((response) => (response.ok ? response.json() : null))
+      .then((data: VncConfig | null) => {
+        if (!cancelled) setConfig(data ?? { enabled: false, url: null });
+      })
+      .catch(() => {
+        if (!cancelled) setConfig({ enabled: false, url: null });
+      });
+    return () => { cancelled = true; };
+  }, []);
+
+  const src = useMemo(() => {
+    if (!config?.enabled || !config.url) return null;
+    return withPassword(config.url, config.password);
+  }, [config]);
+
+  return (
+    <section className={`vnc-panel${active ? " is-active" : ""}`} aria-label={t("vnc.title")} data-tab-id={tab.id}>
+      <header className="vnc-panel-header">
+        <div className="vnc-panel-title">
+          <span className={`vnc-status-dot${src ? " is-ready" : config === undefined ? " is-connecting" : " is-error"}`} />
+          <span>{t("vnc.title")}</span>
+        </div>
+        <div className="vnc-panel-actions">
+          <button
+            type="button"
+            onClick={() => setReloadKey((key) => key + 1)}
+            disabled={!src}
+            title={t("vnc.reload")}
+            aria-label={t("vnc.reload")}
+          >
+            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+              <path d="M20 11a8 8 0 1 0-2.34 5.66" /><polyline points="20 4 20 11 13 11" />
+            </svg>
+          </button>
+          {src && (
+            <a href={src} target="_blank" rel="noopener noreferrer" title={t("vnc.openInNewTab")} aria-label={t("vnc.openInNewTab")}>
+              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+                <path d="M14 4h6v6" /><path d="M20 4 10 14" /><path d="M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6" />
+              </svg>
+            </a>
+          )}
+        </div>
+      </header>
+      <div className="vnc-frame">
+        {src ? (
+          <iframe
+            key={reloadKey}
+            className="vnc-frame-iframe"
+            src={src}
+            title={t("vnc.title")}
+            allow="clipboard-read; clipboard-write"
+          />
+        ) : (
+          <div className="vnc-placeholder" role="status">
+            {config === undefined ? t("vnc.loading") : t("vnc.unavailable")}
+          </div>
+        )}
+      </div>
+    </section>
+  );
+}
diff --git a/components/vnc-tab-state.test.mjs b/components/vnc-tab-state.test.mjs
new file mode 100644
index 0000000..d400193
--- /dev/null
+++ b/components/vnc-tab-state.test.mjs
@@ -0,0 +1,22 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { newVncTab, restoreVncTabs } from "./vnc-tab-state.ts";
+
+test("restored VNC tabs retain their identity", () => {
+  const first = newVncTab();
+  const second = newVncTab();
+  assert.notEqual(first.id, second.id);
+  const saved = restoreVncTabs(JSON.stringify({ vncTabs: [first, second], activeId: second.id, open: true }));
+  assert.deepEqual(saved, { tabs: [first, second], activeId: second.id, open: true });
+});
+
+test("storage corruption cannot create invalid or duplicate VNC tabs", () => {
+  assert.deepEqual(restoreVncTabs("broken"), { tabs: [], activeId: null, open: false });
+  assert.deepEqual(restoreVncTabs(null), { tabs: [], activeId: null, open: false });
+  const tab = newVncTab();
+  const saved = restoreVncTabs(JSON.stringify({
+    vncTabs: [null, {}, tab, tab, { id: "../../bad" }],
+    activeId: "missing",
+  }));
+  assert.deepEqual(saved, { tabs: [tab], activeId: null, open: false });
+});
diff --git a/components/vnc-tab-state.ts b/components/vnc-tab-state.ts
new file mode 100644
index 0000000..d38cc13
--- /dev/null
+++ b/components/vnc-tab-state.ts
@@ -0,0 +1,35 @@
+export interface VncTab {
+  id: string;
+}
+
+// VNC tabs share the workspace-tab storage blob with terminal tabs so a single
+// active-tab/panel-open value keeps restoring both kinds consistently.
+export const VNC_TABS_KEY = "pi-web:vnc-tabs";
+
+function randomId(): string {
+  return Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, "0")).join("");
+}
+
+export function newVncTab(): VncTab {
+  return { id: randomId() };
+}
+
+export function restoreVncTabs(raw: string | null): { tabs: VncTab[]; activeId: string | null; open: boolean } {
+  try {
+    const saved = JSON.parse(raw ?? "null");
+    const tabs: VncTab[] = [];
+    for (const tab of Array.isArray(saved?.vncTabs) ? saved.vncTabs : []) {
+      if (tab && typeof tab.id === "string" && /^[a-f0-9]{32}$/.test(tab.id)
+        && !tabs.some((existing) => existing.id === tab.id)) {
+        tabs.push({ id: tab.id });
+      }
+    }
+    return {
+      tabs,
+      activeId: tabs.some((tab) => tab.id === saved.activeId) ? saved.activeId : null,
+      open: saved?.open === true,
+    };
+  } catch {
+    return { tabs: [], activeId: null, open: false };
+  }
+}
