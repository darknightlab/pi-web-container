{
  "mcpServers": {
    "cua-driver": {
      "command": "/nix/var/nix/profiles/runtime/bin/cua-driver",
      "args": ["mcp"],
      "env": {
        "CUA_DRIVER_PERMISSION_MODE": "standard"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--isolated"],
      "env": {
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
        "PLAYWRIGHT_MCP_NO_SANDBOX": "1",
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/nix/var/nix/profiles/runtime/bin/chromium"
      }
    }
  }
}
