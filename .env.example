# pi-web-container / compose
PI_WEB_IMAGE=ghcr.io/darknightlab/pi-web-container:main
PI_WEB_REPOSITORY=https://github.com/canoziia/pi-web.git
PI_WEB_REF=main
PI_WEB_BIND_ADDR=127.0.0.1
PI_WEB_PORT=30141
PASEO_PORT=6767
PASEO_ENABLED=true
CONTAINER_BIND_ADDR=127.0.0.1

# Virtual desktop
DISPLAY=:0
XVFB_RESOLUTION=1920x1080x24
NOVNC_ENABLED=false
NOVNC_BIND_ADDR=127.0.0.1
NOVNC_PORT=6080
NOVNC_PUBLISH_ADDR=127.0.0.1
VNC_INTERNAL_PORT=5900
# VNC_PASSWORD=change-me

# PI Web
# PI_WEB_PASSWORD=change-me
# PI_WEB_ALLOWED_HOSTS=pi.example.com

# Paseo
# PASEO_PASSWORD=change-me
# PASEO_HOSTNAMES=paseo.example.com,.lan
# PASEO_RELAY_ENDPOINT=relay.example.com:443
# PASEO_RELAY_USE_TLS=true
# PASEO_RELAY_PUBLIC_ENDPOINT=relay.example.com:443
# PASEO_RELAY_PUBLIC_USE_TLS=true

# PASEO_RELAY_ENABLED is intentionally unset. First start enables relay through
# `paseo daemon pair --relay`, keeping the setting mutable in config.json.
